{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "type": "stat", "title": "Service availability", "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=~\"gateway|order|inventory|fulfillment\"}", "legendFormat": "{{job}}", "refId": "A" }],
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries", "title": "HTTP request rate", "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (job) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{job}}", "refId": "A" }],
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "timeseries", "title": "P95 latency", "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{job}}", "refId": "A" }],
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 }
    },
    {
      "type": "timeseries", "title": "Transactional outbox backlog", "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "autoflow_outbox_pending", "legendFormat": "{{job}}", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries", "title": "Pending dead letters", "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "autoflow_dead_letters_pending", "legendFormat": "{{job}}", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }
    }
  ],
  "schemaVersion": 41,
  "tags": ["autoflow", "rocketmq", "orders"],
  "templating": { "list": [] },
